{
  "name": "ltpa",
  "version": "3.3.0",
  "description": "Ltpa token generation and validation",
  "keywords": [
    "authentication",
    "ibm",
    "lotus",
    "ltpa",
    "token",
    "validation",
    "websphere"
  ],
  "homepage": "https://github.com/markusberg/ltpa#readme",
  "bugs": {
    "url": "https://github.com/markusberg/ltpa/issues"
  },
  "license": "Apache-2.0",
  "author": "Markus Berg <markus@kelvin.nu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markusberg/ltpa.git"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "npm run clean && npm run build:prod && npm run docs",
    "build:prod": "tsc -p ./tsconfig.prod.json",
    "build:test": "tsc -p .",
    "clean": "rimraf dist *.tsbuildinfo coverage && mkdir -p dist coverage",
    "docs": "rimraf docs && typedoc",
    "prepublishOnly": "npm run build",
    "test": "npm run clean && npm run test:one",
    "test:one": "npm run build:test && node --enable-source-maps --test --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=./coverage/lcov.info ./dist/**/*.test.js && npm run test:cov",
    "test:cov": "lcov-parse --summary ./coverage/lcov.info > ./coverage/coverage-summary.json",
    "test:watch": "npm run clean && nodemon -e ts -w ./src --exec 'npm run test:one'",
    "test:performance": "npm run build:test && node --allow-natives-syntax ./dist/*.perf.js",
    "githooks": "husky && chmod ug+x .husky/*",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prep": "npm install && npm run githooks"
  },
  "dependencies": {},
  "devDependencies": {
    "@markusberg/lcov-parse": "^3.0.0",
    "@types/node": "^24.12.4",
    "bench-node": "^0.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "(*.ts|*.md)": "npm run fmt"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
